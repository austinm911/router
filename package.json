{
	"name": "the-forge",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"workspaces": ["apps/*", "packages/*"],
	"scripts": {
		"build": "turbo build",
		"check": "turbo check",
		"dev": "turbo dev",
		"clean": "turbo run clean && rm -rf node_modules .turbo bun.lockb tmp",
		"format": "prettier --write \"**/*.{ts,tsx,md}\"",
		"lint": "turbo lint",
		"update-packages": "bunx taze -I --recursive",
		"skott": "bunx skott",
		"dcruise": "depcruise packages --include-only \" env|ui|misc\" --output-type dot | dot -T svg > dependency-graph.svg"
	},
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@cloudflare/workers-types": "cloudflare/workers-types",
		"@forge/eslint-config": "workspace:*",
		"@forge/tsconfig": "workspace:*",
		"@types/bun": "^1.1.16",
		"dependency-cruiser": "^16.9.0",
		"prettier": "^3.4.2",
		"skott": "^0.35.4",
		"turbo": "^2.3.3",
		"typescript": "5.7.3"
	},
	"packageManager": "bun@1.1.43",
	"engines": {
		"node": ">=20"
	},
	"trustedDependencies": ["@biomejs/biome", "esbuild"]
}
