{
	"$schema": "https://json.schemastore.org/tsconfig",
	"display": "Next.js",
	"extends": "./base.json",
	"compilerOptions": {
		"types": [
			"@cloudflare/workers-types",
			"@types/bun",
			"@types/react",
			"@types/react-dom"
		],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowJs": true,
		"jsx": "preserve",
		"noEmit": true
	}
}
